<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rlsok_nav2">
    <gravity>0 0 0</gravity>
    <physics name="default" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <model name="rlsok_base">
      <link name="base_link">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.4 0.3 0.1</size></box></geometry></collision>
      </link>
      <link name="left_wheel"><pose>0 0.2 0 1.570796 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial></link>
      <link name="right_wheel"><pose>0 -0.2 0 1.570796 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial></link>
      <joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.4</wheel_separation><wheel_radius>0.1</wheel_radius>
        <topic>/model/rlsok_base/cmd_vel</topic><odom_topic>/model/rlsok_base/odometry</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
